pragma solidity ^0.8.0;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract NewtonCoin is ERC20, Ownable {
    constructor() ERC20("NewtonCoin", "NWT") {
        _mint(msg.sender, 1_000_000_000 * 10 ** decimals()); // Минтим 1 млрд токенов владельцу
    }

    function burn(uint256 amount) public {
        _burn(msg.sender, amount); // Функция сжигания токенов
    }
}
